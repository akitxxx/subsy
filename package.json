{
  "name": "subsy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --fix ./src",
    "format": "oxfmt --write ./src",
    "db:generate": "dotenv -e .env -- pnpm drizzle-kit generate --config=./drizzle/drizzle.config.ts",
    "db:migrate": "dotenv -e .env -- pnpm drizzle-kit migrate --config=./drizzle/drizzle.config.ts",
    "db:migrate:test": "dotenv -e .env.test pnpm run db:migrate",
    "db:reset": "dotenv -e .env tsx drizzle/reset.ts",
    "db:reset:test": "dotenv -e .env.test tsx drizzle/reset.ts",
    "test:front": "vitest run --config=./vitest.config.ts --dir src/app",
    "test:back": "vitest run --config=./vitest.config.ts --dir src/app/api",
    "test": "vitest run --config=./vitest.config.ts",
    "db:up": "dotenv -e .env -- pnpm exec supabase start",
    "db:down": "pnpm exec supabase stop"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@line/bot-sdk": "^10.6.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "drizzle-orm": "^0.45.1",
    "effect": "^3.19.19",
    "hono": "^4.12.7",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "openai": "^6.29.0",
    "postgres": "^3.4.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "ts-pattern": "^5.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.9",
    "lefthook": "^2.1.4",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "postcss": "^8.5.8",
    "supabase": "^2.78.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.5.2"
  },
  "packageManager": "pnpm@10.32.1"
}
