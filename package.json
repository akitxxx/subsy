{
  "name": "subsy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "vp lint --fix ./src",
    "format": "vp fmt --write ./src",
    "check": "vp check ./src",
    "check:fix": "vp check --fix ./src",
    "typecheck": "vp lint --type-check --type-aware -A all ./src",
    "db:generate": "dotenv -e .env -- pnpm drizzle-kit generate --config=./drizzle/drizzle.config.ts",
    "db:migrate": "dotenv -e .env -- pnpm drizzle-kit migrate --config=./drizzle/drizzle.config.ts",
    "db:migrate:test": "dotenv -e .env.test pnpm run db:migrate",
    "db:reset": "dotenv -e .env tsx drizzle/reset.ts",
    "db:reset:test": "dotenv -e .env.test tsx drizzle/reset.ts",
    "test:front": "vp test --dir src/app",
    "test:back": "vp test --dir src/app/api",
    "test": "vp test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.0.4",
    "@hono/clerk-auth": "^3.1.0",
    "@hono/zod-validator": "^0.7.6",
    "@line/bot-sdk": "^10.6.0",
    "@neondatabase/serverless": "^1.0.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "drizzle-orm": "^0.45.1",
    "effect": "^3.19.19",
    "hono": "^4.12.7",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "openai": "^6.29.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "ts-pattern": "^5.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.9",
    "jsdom": "^29.0.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-plus": "^0.1.11",
    "ws": "^8.19.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.5.2"
  },
  "packageManager": "pnpm@10.32.1"
}
