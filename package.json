{
  "name": "subsy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.3.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.3.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint --write ./src/**/*",
    "format": "biome format ./src/**/* --write",
    "db:generate": "drizzle-kit generate --config=./drizzle/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=./drizzle/drizzle.config.ts",
    "db:reset": "tsx drizzle/reset.ts",
    "db:reset:test": "dotenv -e .env.test tsx drizzle/reset.ts",
    "test:front": "vitest run --dir src/app",
    "test:back": "vitest run --dir src/app/api",
    "test": "vitest run --config=./vitest.config.ts",
    "db:up": "supabase start"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.2",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.48.1",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.4",
    "hono": "^4.7.0",
    "lucide-react": "^0.471.2",
    "next": "15.1.4",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.3.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.17.17",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.30.4",
    "lefthook": "^1.10.10",
    "postcss": "^8.5.2",
    "supabase": "^2.12.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
