{
  "name": "subsy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.5.2"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint --write ./src/**/*",
    "format": "biome format ./src/**/* --write",
    "db:generate": "dotenv -e .env -- pnpm drizzle-kit generate --config=./drizzle/drizzle.config.ts",
    "db:migrate": "dotenv -e .env -- pnpm drizzle-kit migrate --config=./drizzle/drizzle.config.ts",
    "db:migrate:test": "dotenv -e .env.test pnpm run db:migrate",
    "db:reset": "dotenv -e .env tsx drizzle/reset.ts",
    "db:reset:test": "dotenv -e .env.test tsx drizzle/reset.ts",
    "test:front": "vitest run --config=./vitest.config.ts --dir src/app",
    "test:back": "vitest run --config=./vitest.config.ts --dir src/app/api",
    "test": "vitest run --config=./vitest.config.ts",
    "db:up": "dotenv -e .env -- npx supabase start",
    "db:down": "npx supabase stop"
  },
  "dependencies": {
    "@clerk/backend": "^2.32.0",
    "@clerk/nextjs": "^6.38.1",
    "@hono/clerk-auth": "^3.1.0",
    "@hono/zod-validator": "^0.7.6",
    "@line/bot-sdk": "^10.6.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.97.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.1",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "openai": "^6.22.0",
    "postgres": "^3.4.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "swr": "^2.4.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.9",
    "lefthook": "^2.1.1",
    "postcss": "^8.5.6",
    "supabase": "^2.76.12",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
