{
  "plugins": ["typescript", "import", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "eqeqeq": "warn",
    "react-in-jsx-scope": "off",
    "no-shadow": "off",
    "no-unused-expressions": "off",
    "no-unassigned-import": "off"
  },
  "ignorePatterns": ["node_modules", ".next", "drizzle"]
}
